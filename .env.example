# --- データベース ---
# 開発: SQLite / 本番: PostgreSQL(例: postgresql://user:pass@host:5432/dbname)
# 本番でPostgreSQLへ切り替える場合は prisma/schema.prisma の provider も
# "postgresql" に変更すること(README参照)
DATABASE_URL="file:./dev.db"

# --- トークン ---
# 受信者別トークンのハッシュ化に使うシークレット(32文字以上のランダム値を推奨)
# 生成例: openssl rand -base64 32
PREFERENCE_TOKEN_SECRET=

# --- アプリ ---
# メール内リンクの生成に使うベースURL(本番: https://example.com)
APP_BASE_URL=http://localhost:3000

# キャンペーンID(ConsentEvent・分析イベントに記録)
CAMPAIGN_ID=launch_2026_joint

# --- メール配信システム連携 ---
# mock | (実サービス名を追加実装後に指定)
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_API_KEY=

# サポートメールアドレス
SUPPORT_EMAIL=

# --- 分析 ---
# Google Tag Manager ID(未設定なら分析タグを読み込まない)
NEXT_PUBLIC_GTM_ID=

# --- デモモード ---
# "false" 以外ならデモモード(メールプレビュー画面が有効・配信連携はMock固定)
DEMO_MODE=true
